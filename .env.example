# MaintainIQ Environment Configuration

# Database Configuration (MySQL)
# Option A: Specific MySQL connection fields (Recommended)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=maintainiq

# Option B: Full connection string (takes precedence if specified)
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/maintainiq
# SQLite fallback (used automatically if no MySQL credentials are set):
# DATABASE_URL=sqlite:///./maintainiq.db

# Server port (default: 3000)
PORT=3000
